<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.runtrack</groupId>
    <artifactId>runtrack-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>runtrack-feed</artifactId>
  <name>runtrack-feed</name>
  <description>Projection de lecture du fil d'actualité</description>

  <!-- Toute dépendance listée ici est une arête du graphe du §2 : la déclarer, c'est la
       décider. Maven rend le cycle impossible ; ApplicationModules.verify() interdit en
       plus d'atteindre le paquet internal du voisin, ce que le classpath autorise. -->
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId></dependency>
    <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-api</artifactId></dependency>
    <dependency><groupId>com.runtrack</groupId><artifactId>runtrack-shared</artifactId></dependency>
    <dependency><groupId>com.runtrack</groupId><artifactId>runtrack-platform</artifactId></dependency>
    <dependency><groupId>com.runtrack</groupId><artifactId>runtrack-user</artifactId></dependency>
    <dependency><groupId>com.runtrack</groupId><artifactId>runtrack-social</artifactId></dependency>
    <dependency><groupId>com.runtrack</groupId><artifactId>runtrack-course</artifactId></dependency>
    <dependency><groupId>com.runtrack</groupId><artifactId>runtrack-engagement</artifactId></dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- En Boot 4 les auto-configurations sont éclatées : flyway-core seul n'active plus
         la migration au démarrage, c'est spring-boot-flyway qui la porte. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- For @AuthenticationPrincipal only: the controller reads the Viewer that the auth
         module's filter placed in the context, without depending on that module. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
  </dependencies>
</project>
